# KI Provider — setze einen der beiden Keys (Gemini hat Vorrang wenn beide gesetzt)
# Google Gemini (kostenlos, 1500 Requests/Tag)
GEMINI_API_KEY=dein_gemini_key_hier

# Anthropic Claude (wird verwendet wenn kein GEMINI_API_KEY gesetzt)
ANTHROPIC_API_KEY=sk-ant-...

# FRED API Key (optional — kostenlose Makrodaten)
# Registrierung: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=dein_fred_key_hier

# Tradovate Credentials (optional — Echtzeit-Preisfeed via Demo-Konto)
# Kostenloses Demo-Konto: https://trader.tradovate.com/register
TRADOVATE_USERNAME=deine@email.com
TRADOVATE_PASSWORD=dein_passwort
TRADOVATE_APP_ID=Sample App
TRADOVATE_APP_VERSION=1.0

# Rithmic Credentials (nur für --live Mode nötig)
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM_NAME=
RITHMIC_APP_NAME=nq_trading_assistant
RITHMIC_APP_VERSION=1.0
RITHMIC_URL=rituz00100.rithmic.com:443
